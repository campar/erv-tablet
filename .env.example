# Copy to .env (bundled as an asset, see pubspec.yaml) and fill in the values.
BACKEND_API_ADDRESS=erv.example.com
# Base64-encoded Basic auth credentials of the device account on the backend
USER_NAME=
PASSWORD=
# PIN that unlocks the settings screen
SECURITY_PIN_CODE=
# Cron expression for the job that resends queued actions
ACTION_SERVICE_JOB_CRON_EXP='0 3 * * * '
